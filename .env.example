# Nusxa oling: cp .env.example .env  (keyin .env dagi qiymatlarni o'zgartiring)
# .env gitga kirmaydi. Bu fayl faqat qaysi sozlamalar kerakligini ko'rsatadi.

# PostgreSQL. docker-compose.yml ham shu qiymatlarni o'qiydi.
POSTGRES_USER=semantic
POSTGRES_PASSWORD=semantic
POSTGRES_DB=semantic_qa
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# bge-m3 modeli: hf download + scripts/convert_model_fp16.py (docs/ORNATISH.md, 6-bo'lim)
MODEL_PATH=models/bge-m3-fp16

# Qdrant (vektor baza)
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=questions
